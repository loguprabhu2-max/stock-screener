# =====================================================
# LOCAL DEVELOPMENT (use these on your laptop)
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_screener
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Flask secret key (any long random string; for local dev only)
SECRET_KEY=change-me-to-a-long-random-string-12345


# =====================================================
# PRODUCTION (used on Render — set these in Render's
# Environment Variables tab, NOT in this file)
# =====================================================
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# SECRET_KEY=use-python-secrets-token_hex-32-to-generate-this
